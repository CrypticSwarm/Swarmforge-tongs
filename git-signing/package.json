{
  "name": "swarmforge-tong-git-signing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A Swarmforge tong: holds a GPG signing key and signs the workspace's unpublished commits, so the agent never touches key material.",
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test \"dist/test/*.test.js\"",
    "test:e2e": "tsc && node --test \"dist/test/e2e/*.test.js\"",
    "start": "node dist/src/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.0",
    "express": "^4.21.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
